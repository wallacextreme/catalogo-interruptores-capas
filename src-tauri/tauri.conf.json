{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CatalogoInterruptoresCapas",
  "version": "1.0.0",
  "identifier": "com.balcao.interruptores",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Catálogo de Balcão — Interruptores & Capas",
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
